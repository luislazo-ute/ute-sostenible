<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="vista_registro_pesaje_lista" model="ir.ui.view">
        <field name="name">ute_sostenible.registro_pesaje.lista</field>
        <field name="model">ute_sostenible.registro_pesaje</field>
        <field name="arch" type="xml">
            <list string="Registros de pesaje">
                <field name="numero"/>
                <field name="fecha"/>
                <field name="hora" widget="float_time"/>
                <field name="responsable_id"/>
                <field name="punto_ecologico_id"/>
                <field name="bloque_id"/>
                <field name="piso_id"/>
                <field name="peso_total_kg"/>
                <field name="estado"/>
            </list>
        </field>
    </record>

    <record id="vista_registro_pesaje_formulario" model="ir.ui.view">
        <field name="name">ute_sostenible.registro_pesaje.formulario</field>
        <field name="model">ute_sostenible.registro_pesaje</field>
        <field name="arch" type="xml">
            <form string="Registro de pesaje">
                <header>
                    <button name="accion_confirmar" type="object" string="Confirmar" class="btn-primary" invisible="estado != 'borrador'"/>
                    <button name="accion_cancelar" type="object" string="Cancelar" invisible="estado == 'cancelado'"/>
                    <button name="accion_volver_borrador" type="object" string="Volver a borrador" invisible="estado == 'borrador'"/>
                    <field name="estado" widget="statusbar" statusbar_visible="borrador,confirmado,cancelado"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="numero" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Datos generales">
                            <field name="fecha"/>
                            <field name="hora" widget="float_time"/>
                            <field name="responsable_id"/>
                            <field name="origen"/>
                        </group>
                        <group string="Ubicación">
                            <field name="punto_ecologico_id"/>
                            <field name="campus_id"/>
                            <field name="bloque_id"/>
                            <field name="piso_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tipo de residuo (kg)">
                            <field name="linea_ids">
                                <list editable="bottom">
                                    <field name="tipo_residuo_id"/>
                                    <field name="presente"/>
                                    <field name="peso_kg"/>
                                    <field name="observaciones"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="peso_total_kg" readonly="1"/>
                            </group>
                        </page>
                        <page string="Observaciones y firma">
                            <group>
                                <field name="observaciones"/>
                                <field name="firma"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="vista_registro_pesaje_kanban" model="ir.ui.view">
        <field name="name">ute_sostenible.registro_pesaje.kanban</field>
        <field name="model">ute_sostenible.registro_pesaje</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-start">
                            <field name="numero" class="fw-bold"/>
                            <field name="estado"/>
                        </div>
                        <div class="text-muted">
                            <field name="fecha"/>
                            <span> - </span>
                            <field name="responsable_id"/>
                        </div>
                        <div>
                            <field name="punto_ecologico_id"/>
                        </div>
                        <div class="text-muted">
                            <field name="bloque_id"/>
                            <span> / </span>
                            <field name="piso_id"/>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Total kg</span>
                            <field name="peso_total_kg"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="accion_registro_pesaje" model="ir.actions.act_window">
        <field name="name">Registros de pesaje</field>
        <field name="res_model">ute_sostenible.registro_pesaje</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="mobile_view_mode">kanban</field>
    </record>
</odoo>
