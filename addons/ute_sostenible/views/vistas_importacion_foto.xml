<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="vista_importacion_foto_pesaje_lista" model="ir.ui.view">
        <field name="name">ute_sostenible.importacion_foto_pesaje.lista</field>
        <field name="model">ute_sostenible.importacion_foto_pesaje</field>
        <field name="arch" type="xml">
            <list string="Importaciones desde foto">
                <field name="name"/>
                <field name="fecha_importacion"/>
                <field name="usuario_importacion_id"/>
                <field name="estado"/>
                <field name="total_lineas_detectadas"/>
                <field name="total_lineas_correctas"/>
                <field name="total_lineas_revision"/>
                <field name="total_lineas_error"/>
            </list>
        </field>
    </record>

    <record id="vista_importacion_foto_pesaje_formulario" model="ir.ui.view">
        <field name="name">ute_sostenible.importacion_foto_pesaje.formulario</field>
        <field name="model">ute_sostenible.importacion_foto_pesaje</field>
        <field name="arch" type="xml">
            <form string="Importar desde foto">
                <header>
                    <button name="action_procesar_foto" type="object" string="Procesar foto" class="btn-primary" invisible="estado == 'confirmado'"/>
                    <button name="action_recalcular_lineas" type="object" string="Recalcular líneas" invisible="not lineas_ids"/>
                    <button name="action_crear_registros" type="object" string="Crear registros" class="btn-primary" invisible="estado not in ('procesado', 'error')"/>
                    <field name="estado" widget="statusbar" statusbar_visible="borrador,procesado,confirmado,error"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Para mejorar la lectura OCR, use una sola fila por registro, escriba dentro de cada celda y tome la foto de frente, con buena iluminación y sin cortar la tabla.
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Foto">
                            <field name="foto_planilla" filename="nombre_archivo" widget="image"/>
                            <field name="nombre_archivo" invisible="1"/>
                            <field name="fecha_importacion"/>
                            <field name="usuario_importacion_id"/>
                        </group>
                        <group string="Resumen">
                            <field name="total_lineas_detectadas"/>
                            <field name="total_lineas_correctas"/>
                            <field name="total_lineas_revision"/>
                            <field name="total_lineas_error"/>
                            <field name="mensaje_error" invisible="not mensaje_error"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Líneas detectadas">
                            <field name="lineas_ids">
                                <list editable="bottom" decoration-success="estado_linea == 'correcto'" decoration-warning="estado_linea == 'revisar'" decoration-danger="estado_linea == 'error'">
                                    <field name="crear_registro"/>
                                    <field name="numero_linea"/>
                                    <field name="estado_linea" widget="badge" decoration-success="estado_linea == 'correcto'" decoration-warning="estado_linea == 'revisar'" decoration-danger="estado_linea == 'error'"/>
                                    <field name="fecha"/>
                                    <field name="hora" widget="float_time"/>
                                    <field name="responsable_texto"/>
                                    <field name="responsable_id"/>
                                    <field name="edificio_texto"/>
                                    <field name="bloque_id"/>
                                    <field name="piso_texto"/>
                                    <field name="piso_id"/>
                                    <field name="estacion"/>
                                    <field name="punto_ecologico_id"/>
                                    <field name="bolsa_azul"/>
                                    <field name="bolsa_negra"/>
                                    <field name="bolsa_verde"/>
                                    <field name="observaciones"/>
                                    <field name="firma_texto"/>
                                    <field name="confianza_ocr"/>
                                    <field name="mensaje_error"/>
                                </list>
                            </field>
                        </page>
                        <page string="Imagen procesada">
                            <field name="imagen_procesada" widget="image"/>
                        </page>
                        <page string="Instrucciones OCR">
                            <div class="alert alert-light border" role="alert">
                                <p><strong>Antes de procesar la foto</strong></p>
                                <ol>
                                    <li>Usar una sola fila por cada registro de pesaje.</li>
                                    <li>No escribir dos registros en la misma fila.</li>
                                    <li>Escribir dentro de los bordes de cada celda.</li>
                                    <li>No invadir columnas vecinas.</li>
                                    <li>Usar letra clara, preferiblemente mayúscula imprenta.</li>
                                    <li>No usar abreviaturas raras.</li>
                                    <li>La fecha debe escribirse como DD/MM/AAAA. Ejemplo: 25/05/2026.</li>
                                    <li>La hora debe escribirse en formato 24 horas. Ejemplo: 14:30.</li>
                                    <li>El responsable debe escribirse con el mismo nombre usado en Odoo.</li>
                                    <li>El edificio debe escribirse igual que el bloque registrado en Odoo. Ejemplo: Bloque A.</li>
                                    <li>El piso debe escribirse de forma consistente. Ejemplos válidos: PB, 1er piso, 2do piso, 3er piso.</li>
                                    <li>La estación debe coincidir con la ubicación o punto ecológico registrado en Odoo.</li>
                                    <li>Los pesos deben escribirse solo con números.</li>
                                    <li>Los pesos deben estar en kilogramos.</li>
                                    <li>Para decimales, usar preferiblemente punto. Ejemplo: 2.5.</li>
                                    <li>Evitar escribir kg dentro de las columnas de peso.</li>
                                    <li>Si una bolsa no tiene peso, escribir 0 o dejar en blanco.</li>
                                    <li>No usar tachones.</li>
                                    <li>No escribir encima de líneas de la tabla.</li>
                                    <li>La firma no será usada como dato obligatorio; quedará respaldada en la foto.</li>
                                    <li>Tomar la foto de frente.</li>
                                    <li>No tomar la foto inclinada.</li>
                                    <li>La tabla completa debe aparecer en la foto.</li>
                                    <li>No cortar encabezados ni bordes.</li>
                                    <li>Usar buena iluminación.</li>
                                    <li>Evitar sombras sobre la hoja.</li>
                                    <li>Evitar fotos borrosas.</li>
                                    <li>Si la foto no se lee bien, el sistema permitirá corregir manualmente antes de crear los registros.</li>
                                </ol>
                            </div>
                        </page>
                        <page string="Técnico">
                            <group>
                                <field name="texto_detectado"/>
                                <field name="json_ocr"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="vista_importacion_foto_pesaje_kanban" model="ir.ui.view">
        <field name="name">ute_sostenible.importacion_foto_pesaje.kanban</field>
        <field name="model">ute_sostenible.importacion_foto_pesaje</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold"/>
                        <div class="text-muted">
                            <field name="fecha_importacion"/>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Estado</span>
                            <field name="estado"/>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Detectadas</span>
                            <field name="total_lineas_detectadas"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="accion_importacion_foto_pesaje" model="ir.actions.act_window">
        <field name="name">Importar desde foto</field>
        <field name="res_model">ute_sostenible.importacion_foto_pesaje</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="mobile_view_mode">kanban</field>
        <field name="context">{'default_name': 'Importación desde foto'}</field>
    </record>
</odoo>
