                        <group>
                            <field name="descripcion"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Pisos">
                            <field name="piso_ids" readonly="1">
                                <list>
                                    <field name="nombre"/>
                                    <field name="codigo"/>
                                    <field name="activo"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="vista_bloque_kanban" model="ir.ui.view">
