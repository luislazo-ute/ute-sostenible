<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="vista_plantilla_pesaje_wizard_formulario" model="ir.ui.view">
        <field name="name">ute_sostenible.plantilla_pesaje_wizard.formulario</field>
        <field name="model">ute_sostenible.plantilla_pesaje_wizard</field>
        <field name="arch" type="xml">
            <form string="Plantilla de pesaje">
                <sheet>
                    <group>
                        <field name="fecha"/>
                        <field name="campus_id"/>
                        <field name="bloque_id" domain="[('campus_id', '=', campus_id)]" readonly="not campus_id"/>
                    </group>
                    <p class="text-muted">
                        Se imprime la planilla del campus seleccionado con sus estaciones (edificio, piso y estación) ya impresas en orden. Si además se elige un bloque/edificio, la planilla sale solo de ese bloque; si se deja vacío, salen todas las estaciones del campus. La fecha se imprime en todas las filas y la hora queda como __:__ para completar manualmente. Si el campus tiene más de 28 estaciones se generan varias hojas de 28 filas para poder escanearlas por separado. También puede exportar la planilla a Excel.
                    </p>
                </sheet>
                <footer>
                    <button name="action_imprimir_plantilla" type="object" string="Imprimir plantilla (PDF)" class="btn-primary"/>
                    <button name="action_exportar_excel" type="object" string="Exportar Excel" class="btn-secondary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="accion_plantilla_pesaje_wizard" model="ir.actions.act_window">
        <field name="name">Plantilla de pesaje</field>
        <field name="res_model">ute_sostenible.plantilla_pesaje_wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="vista_registro_pesaje_lista" model="ir.ui.view">
        <field name="name">ute_sostenible.registro_pesaje.lista</field>
        <field name="model">ute_sostenible.registro_pesaje</field>
        <field name="arch" type="xml">
            <list string="Registros de pesaje">
                <header>
                    <button name="%(accion_plantilla_pesaje_wizard)d" type="action" string="Plantilla PDF" class="btn-primary"/>
                </header>
                <field name="numero"/>
                <field name="fecha"/>
                <field name="hora" widget="float_time"/>
                <field name="responsable_id"/>
                <field name="origen_registro"/>
                <field name="punto_ecologico_id"/>
                <field name="bloque_id"/>
                <field name="piso_id"/>
                <field name="peso_total_kg"/>
                <field name="estado"/>
            </list>
        </field>
    </record>

    <record id="vista_registro_pesaje_formulario" model="ir.ui.view">
        <field name="name">ute_sostenible.registro_pesaje.formulario</field>
        <field name="model">ute_sostenible.registro_pesaje</field>
        <field name="arch" type="xml">
            <form string="Registro de pesaje">
                <header>
                    <button name="%(accion_plantilla_pesaje_wizard)d" type="action" string="Plantilla PDF" class="btn-secondary"/>
                    <button name="accion_confirmar" type="object" string="Confirmar" class="btn-primary" invisible="estado != 'borrador'"/>
                    <button name="accion_cancelar" type="object" string="Cancelar" invisible="estado == 'cancelado'"/>
                    <button name="accion_volver_borrador" type="object" string="Volver a borrador" invisible="estado == 'borrador'"/>
                    <field name="estado" widget="statusbar" statusbar_visible="borrador,confirmado,cancelado"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="numero" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Datos generales">
                            <field name="fecha"/>
                            <field name="hora" widget="float_time"/>
                            <field name="responsable_id"/>
                            <field name="origen"/>
                            <field name="origen_registro" readonly="1"/>
                        </group>
                        <group string="Ubicación">
                            <field name="punto_ecologico_id"/>
                            <field name="campus_id"/>
                            <field name="bloque_id"/>
                            <field name="piso_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tipo de residuo (kg)">
                            <field name="linea_ids">
                                <list editable="bottom">
                                    <field name="tipo_residuo_id"/>
                                    <field name="presente"/>
                                    <field name="peso_kg"/>
                                    <field name="observaciones"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="peso_total_kg" readonly="1"/>
                            </group>
                        </page>
                        <page string="Observaciones y firma">
                            <group>
                                <field name="observaciones"/>
                                <field name="firma"/>
                            </group>
                        </page>
                        <page string="Auditoría de importación" invisible="origen_registro != 'importacion_foto'">
                            <group>
                                <field name="importacion_foto_nombre"/>
                                <field name="numero_linea_importada"/>
                                <field name="foto_planilla_origen" widget="image"/>
                                <field name="texto_origen_importacion"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="vista_registro_pesaje_kanban" model="ir.ui.view">
        <field name="name">ute_sostenible.registro_pesaje.kanban</field>
        <field name="model">ute_sostenible.registro_pesaje</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-start">
                            <field name="numero" class="fw-bold"/>
                            <field name="estado"/>
                        </div>
                        <div class="text-muted">
                            <field name="fecha"/>
                            <span> - </span>
                            <field name="responsable_id"/>
                        </div>
                        <div>
                            <field name="punto_ecologico_id"/>
                        </div>
                        <div class="text-muted">
                            <field name="bloque_id"/>
                            <span> / </span>
                            <field name="piso_id"/>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Total kg</span>
                            <field name="peso_total_kg"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="accion_registro_pesaje" model="ir.actions.act_window">
        <field name="name">Registros de pesaje</field>
        <field name="res_model">ute_sostenible.registro_pesaje</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="mobile_view_mode">kanban</field>
    </record>

    <record id="accion_importacion_foto_pesaje_desde_registros" model="ir.actions.act_window">
        <field name="name">Importar desde foto</field>
        <field name="res_model">ute_sostenible.importacion_foto_pesaje</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="binding_model_id" ref="model_ute_sostenible_registro_pesaje"/>
        <field name="binding_type">action</field>
    </record>
</odoo>
